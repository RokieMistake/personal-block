---
const articles = [
  {
    title: "The Role of the State",
    category: "Politics",
    date: "10 October 2026",
    description: "Reflections on state power, individual freedom and responsibility."
  },
  {
    title: "Understanding Public Finance",
    category: "Economics",
    date: "10 October 2026",
    description: "Notes on taxation, public spending and the role of government."
  },
  {
    title: "Law and Justice",
    category: "Law",
    date: "10 October 2026",
    description: "Thoughts on the relationship between law, morality and justice."
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A personal journal on politics, economics and law." />
    <title>Personal Journal</title>
  </head>

  <body>
    <header class="site-header">
      <a class="logo" href="/">Personal Journal</a>
      <nav>
        <a href="#essays">Essays</a>
        <a href="#about">About</a>
      </nav>
    </header>

    <main>
      <section class="intro">
        <p class="eyebrow">A PERSONAL PUBLICATION</p>
        <h1>Ideas worth<br />thinking about.</h1>
        <p class="lead">
          Notes and essays on politics, economics, law and the world around us.
        </p>
      </section>

      <section id="essays" class="essays">
        <div class="section-heading">
          <h2>Selected writing</h2>
          <span>03 essays</span>
        </div>

        {articles.map((article) => (
          <article class="essay">
            <div class="meta">
              <span>{article.category}</span>
              <span>{article.date}</span>
            </div>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
          </article>
        ))}
      </section>

      <section id="about" class="about">
        <h2>About this journal</h2>
        <p>
          An independent space for exploring ideas, asking questions
          and making sense of the world.
        </p>
      </section>
    </main>

    <footer>
      <span>Personal Journal</span>
      <span>Written with curiosity.</span>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #faf9f6;
    color: #272722;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    max-width: 900px;
    margin: auto;
    padding: 28px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e6e3dc;
  }

  .logo {
    font-family: Georgia, serif;
    font-size: 19px;
    font-weight: bold;
  }

  nav {
    display: flex;
    gap: 26px;
    font-size: 13px;
  }

  nav a:hover {
    text-decoration: underline;
  }

  main {
    max-width: 740px;
    margin: auto;
    padding: 0 24px;
  }

  .intro {
    padding: 95px 0 75px;
    border-bottom: 1px solid #e6e3dc;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 2px;
    color: #79766e;
  }

  h1, h2, h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: normal;
    line-height: 1.2;
  }

  h1 {
    font-size: clamp(42px, 8vw, 68px);
    letter-spacing: -2px;
    margin: 24px 0;
  }

  .lead {
    max-width: 480px;
    color: #68665f;
    font-size: 16px;
  }

  .essays {
    padding: 55px 0 30px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .section-heading h2,
  .about h2 {
    font-size: 25px;
  }

  .section-heading span,
  .meta {
    color: #79766e;
    font-size: 12px;
  }

  .essay {
    padding: 25px 0;
    border-bottom: 1px solid #e6e3dc;
  }

  .meta {
    display: flex;
    gap: 18px;
  }

  .essay h3 {
    font-size: 25px;
    margin: 12px 0 6px;
  }

  .essay p,
  .about p {
    color: #68665f;
    font-size: 14px;
  }

  .about {
    padding: 45px 0 75px;
  }

  footer {
    border-top: 1px solid #e6e3dc;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    max-width: 900px;
    margin: auto;
    color: #79766e;
    font-size: 12px;
  }

  @media (max-width: 480px) {
    .site-header {
      padding: 20px;
	}

	nav {
		gap: 14px;
	}

	.intro {
		padding: 65px 0 50px;
	}

	footer {
		flex-wrap: wrap;
	}
}
</style>